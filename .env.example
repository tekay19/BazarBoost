# ============================================
# BazarBoost Backend Environment Variables
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
# cp .env.example .env

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# JWT Secret Key - ÖNEMLİ: Production'da güçlü bir key kullanın!
SECRET_KEY=change-me-to-a-strong-secret-key-min-32-chars

# Token expiration times (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Admin email addresses (comma-separated)
ADMIN_EMAILS=admin@bazarboost.com

# ============================================
# SUPABASE DATABASE
# ============================================
# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (güvenli tutun!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# OPENAI API
# ============================================
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI Model (gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.)
OPENAI_MODEL=gpt-4o

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# SMTP Server (Gmail için: smtp.gmail.com)
SMTP_SERVER=smtp.gmail.com

# SMTP Port (Gmail için: 587)
SMTP_PORT=587

# SMTP Username (Gmail email adresiniz)
SMTP_USERNAME=your-email@gmail.com

# SMTP Password (Gmail App Password - 16 haneli)
SMTP_PASSWORD=your-16-digit-app-password

# Email From Address (genellikle SMTP_USERNAME ile aynı)
EMAIL_FROM=your-email@gmail.com

# ============================================
# PAYMENT PROVIDERS
# ============================================
# Payment Provider (stripe, iyzico, paytr, etc.)
PAYMENT_PROVIDER=stripe

# Payment Base URL (ödeme sayfası URL'i)
PAYMENT_BASE_URL=http://localhost:5173

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ============================================
# APPLICATION SETTINGS
# ============================================
# Default user plan
DEFAULT_PLAN=free

# Default credits for new users
DEFAULT_CREDITS=3

# CORS Origins (comma-separated, * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

# ============================================
# FRONTEND (React)
# ============================================
# Frontend API Base URL (React için)
VITE_API_BASE_URL=http://localhost:8000
