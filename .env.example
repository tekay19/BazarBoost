# ============================================
# QR Menu SaaS — environment variables
# Copy to .env and fill in real values
# ============================================

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qrmenu?schema=public"

# JWT / session signing secret (min 32 chars, change in production!)
SECRET_KEY="change-me-to-a-strong-secret-min-32-characters"

NODE_ENV="development"

# Base URL of the app and the root domain used for subdomain routing.
# Business menus are served at {subdomain}.{ROOT_DOMAIN}
APP_BASE_URL="http://localhost:3000"
ROOT_DOMAIN="localhost:3000"

# Initial super admin (created by the seed script)
SUPER_ADMIN_EMAIL="admin@qrmenu.com"
SUPER_ADMIN_PASSWORD="Admin123!"

# ============================================
# S3-compatible object storage
# (AWS S3 / Cloudflare R2 / MinIO)
# Leave blank in dev to use inline data-URL fallback.
# ============================================
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
